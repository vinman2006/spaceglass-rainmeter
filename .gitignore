# ============================================================================
# SPACEGLASS — GITIGNORE (.gitignore)
# Strictly prevents committing OAuth credentials, tokens, caches, and logs.
# ============================================================================

# Google OAuth Secrets & User Tokens (NEVER COMMIT)
credentials.json
**/credentials.json
token.json
token.bin
**/token.json
**/token.bin
*.pem
*.key
.env

# Runtime Cache, Logs & PID locks
*.sqlite3
*.sqlite3-journal
*.db
*.log
*.pid
*.tmp

# Python Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
